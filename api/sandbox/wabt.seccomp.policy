# wabt seccomp allowlist for minijail0 (-S).
#
# Syntax: "<syscall>: 1" allows the syscall unconditionally; anything not
# listed is killed (minijail's default deny action). Names are resolved at
# load time via the generated syscall table.
#
# Derived empirically with strace for wasm-decompile / wasm2wat 1.0.37 on
# valid and malformed inputs, plus harmless glibc startup calls. execve is
# deliberately NOT listed: minijail installs this filter after exec (via
# its LD_PRELOAD hook), so execve is not needed, and blocking it denies a
# compromised tool any attempt to re-exec.
#
# NOTE: exceptions here must also be reflected in api/sandbox/README.md.
read: 1
readv: 1
pread64: 1
write: 1
writev: 1
lseek: 1
open: 1
openat: 1
close: 1
fstat: 1
newfstatat: 1
statx: 1
stat: 1
lstat: 1
statfs: 1
fstatfs: 1
access: 1
faccessat: 1
faccessat2: 1
fcntl: 1
ioctl: 1
futex: 1
getrandom: 1
prlimit64: 1
getcwd: 1
readlink: 1
readlinkat: 1
sysinfo: 1
uname: 1
clock_gettime: 1
clock_nanosleep: 1
nanosleep: 1
getpid: 1
getppid: 1
gettid: 1
getuid: 1
geteuid: 1
getgid: 1
getegid: 1
getresuid: 1
getresgid: 1
getrusage: 1
sigaltstack: 1
dup: 1
dup2: 1
dup3: 1
poll: 1
ppoll: 1
select: 1
brk: 1
mmap: 1
munmap: 1
mprotect: 1
mremap: 1
madvise: 1
rt_sigreturn: 1
rt_sigaction: 1
rt_sigprocmask: 1
set_tid_address: 1
set_robust_list: 1
rseq: 1
arch_prctl: 1
exit: 1
exit_group: 1
